# Compile the .ts files to .qm and embed them in the executable (no install path to get wrong).
# The .qrc is placed in the build dir, next to the generated .qm files, so rcc finds them
# and meson orders the build correctly.
qt6.compile_translations(
  ts_files: ['perch_es.ts', 'perch_pt.ts'],
  build_by_default: true)

i18n_conf = configuration_data()
i18n_conf.set('note', 'generated by meson: compiled translations embedded in the executable')
i18n_qrc = configure_file(input: 'i18n.qrc', output: 'i18n.qrc', configuration: i18n_conf)
i18n_resources = qt6.compile_resources(sources: i18n_qrc)
